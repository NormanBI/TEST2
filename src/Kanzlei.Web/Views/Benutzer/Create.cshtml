@model BenutzerCreateViewModel
@{
    ViewData["Title"] = "Benutzer anlegen";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-10 col-lg-7">
        <h1 class="h3 mb-3">Neuen Benutzer anlegen</h1>
        <form asp-action="Create" method="post" autocomplete="off">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="row g-3">
                <div class="col-12 col-sm-6">
                    <label asp-for="Vorname" class="form-label"></label>
                    <input asp-for="Vorname" class="form-control" maxlength="100" autofocus />
                    <span asp-validation-for="Vorname" class="text-danger"></span>
                </div>
                <div class="col-12 col-sm-6">
                    <label asp-for="Nachname" class="form-label"></label>
                    <input asp-for="Nachname" class="form-control" maxlength="100" />
                    <span asp-validation-for="Nachname" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Emailadresse" class="form-label"></label>
                    <input asp-for="Emailadresse" type="email" class="form-control" maxlength="254" />
                    <span asp-validation-for="Emailadresse" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Passwort" class="form-label"></label>
                    <input asp-for="Passwort" class="form-control" maxlength="128" autocomplete="new-password" />
                    <div class="form-text">@PasswordPolicy.Hint Das Passwort wird nur als gesalzener Einweg-Hash gespeichert und kann nicht wieder angezeigt werden.</div>
                    <span asp-validation-for="Passwort" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <div class="form-check">
                        <input asp-for="Kundennutzer" class="form-check-input" />
                        <label asp-for="Kundennutzer" class="form-check-label"></label>
                    </div>
                </div>
                <fieldset class="col-12">
                    <legend class="form-label fs-6">Rollen</legend>
                    <div class="form-check"><input asp-for="Administrator" class="form-check-input" /><label asp-for="Administrator" class="form-check-label"></label></div>
                    <div class="form-check"><input asp-for="Eigentuemer" class="form-check-input" /><label asp-for="Eigentuemer" class="form-check-label"></label></div>
                    <div class="form-check"><input asp-for="Steuerberater" class="form-check-input" /><label asp-for="Steuerberater" class="form-check-label"></label></div>
                    <div class="form-check"><input asp-for="Sachbearbeiter" class="form-check-input" /><label asp-for="Sachbearbeiter" class="form-check-label"></label></div>
                </fieldset>
            </div>
            <div class="d-flex flex-wrap gap-2 mt-4">
                <button type="submit" class="btn btn-primary">Anlegen</button>
                <a class="btn btn-outline-secondary" asp-action="Index">Abbrechen</a>
            </div>
        </form>
    </div>
</div>
