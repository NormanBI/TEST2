@{
    ViewData["Title"] = "Mandantengruppen";
}

<nav aria-label="Brotkrumen">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Auswertungen" asp-action="Index">Auswertungen</a></li>
        <li class="breadcrumb-item">Stammdaten</li>
        <li class="breadcrumb-item active" aria-current="page">Mandantengruppen</li>
    </ol>
</nav>

<h1 class="h3 mb-3">Mandantengruppen</h1>
<p class="text-muted">Legen Sie Gruppen an und ordnen Sie Mandanten per Drag &amp; Drop zu. Alternativ steht je Mandant eine Auswahl mit Schaltfläche zur Verfügung. Jeder Mandant gehört höchstens einer Gruppe an; eine neue Zuordnung verschiebt ihn. Die Zuordnungen werden gespeichert und sind für alle berechtigten Benutzer sichtbar.</p>

<div id="mg-app" data-daten-url="@Url.Action("Daten", "Mandantengruppen")" data-anlegen-url="@Url.Action("Anlegen", "Mandantengruppen")"
     data-zuordnen-url="@Url.Action("Zuordnen", "Mandantengruppen")" data-entfernen-url="@Url.Action("Entfernen", "Mandantengruppen")">
    @Html.AntiForgeryToken()

    <div id="mg-meldung" class="alert alert-secondary py-2" role="status" aria-live="polite" hidden></div>

    <div class="row g-3">
        <section class="col-12 col-lg-5" aria-labelledby="mg-clients-titel">
            <div class="card h-100">
                <div class="card-body">
                    <h2 class="h5" id="mg-clients-titel">Nicht zugeordnete Mandanten <span class="badge bg-secondary" id="mg-clients-anzahl">0</span></h2>
                    <label for="mg-client-filter" class="form-label small mb-1">Mandanten filtern</label>
                    <input type="search" id="mg-client-filter" class="form-control mb-2" maxlength="100" placeholder="Nummer, Name, Organisation, Niederlassung" autocomplete="off" />
                    <div id="mg-clients-info" class="small text-muted mb-2"></div>
                    <ul id="mg-clients" class="mg-liste list-unstyled mb-0" data-drop-gruppe="" aria-label="Nicht zugeordnete Mandanten"></ul>
                </div>
            </div>
        </section>

        <section class="col-12 col-lg-7" aria-labelledby="mg-gruppen-titel">
            <div class="card h-100">
                <div class="card-body">
                    <h2 class="h5" id="mg-gruppen-titel">Gruppen <span class="badge bg-secondary" id="mg-gruppen-anzahl">0</span></h2>
                    <form id="mg-anlegen" class="row g-2 mb-3" novalidate>
                        <div class="col">
                            <label for="mg-name" class="visually-hidden">Name der neuen Gruppe</label>
                            <input type="text" id="mg-name" class="form-control" maxlength="100" placeholder="Name der neuen Gruppe" autocomplete="off" required />
                        </div>
                        <div class="col-auto"><button type="submit" class="btn btn-primary">Gruppe anlegen</button></div>
                    </form>
                    <label for="mg-gruppen-filter" class="form-label small mb-1">Gruppen filtern</label>
                    <input type="search" id="mg-gruppen-filter" class="form-control mb-3" maxlength="100" placeholder="Gruppenname" autocomplete="off" />
                    <div id="mg-gruppen" class="row g-3"></div>
                </div>
            </div>
        </section>
    </div>
</div>

@section Scripts {
    <script src="~/js/mandantengruppen.js" asp-append-version="true"></script>
}
