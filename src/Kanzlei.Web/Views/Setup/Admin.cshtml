@model AdminSetupViewModel
@{
    ViewData["Title"] = "Administrator einrichten";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-9 col-lg-6">
        <h1 class="h3 mb-3">Ersten Administrator anlegen</h1>
        <p class="text-muted">In der Datenbank existiert noch kein aktiver Administrator. Legen Sie jetzt das Administratorkonto fest. Das Passwort wird nicht gespeichert, sondern nur als gesalzener Einweg-Hash (nicht umkehrbar) in der Datenbank abgelegt.</p>
        <form asp-action="Admin" method="post" autocomplete="off">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="row g-3">
                <div class="col-12 col-sm-6">
                    <label asp-for="Vorname" class="form-label"></label>
                    <input asp-for="Vorname" class="form-control" maxlength="100" autofocus />
                    <span asp-validation-for="Vorname" class="text-danger"></span>
                </div>
                <div class="col-12 col-sm-6">
                    <label asp-for="Nachname" class="form-label"></label>
                    <input asp-for="Nachname" class="form-control" maxlength="100" />
                    <span asp-validation-for="Nachname" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Emailadresse" class="form-label"></label>
                    <input asp-for="Emailadresse" type="email" class="form-control" maxlength="254" />
                    <span asp-validation-for="Emailadresse" class="text-danger"></span>
                </div>
                <div class="col-12 col-sm-6">
                    <label asp-for="Passwort" class="form-label"></label>
                    <input asp-for="Passwort" class="form-control" maxlength="128" autocomplete="new-password" />
                    <span asp-validation-for="Passwort" class="text-danger"></span>
                </div>
                <div class="col-12 col-sm-6">
                    <label asp-for="PasswortWiederholung" class="form-label"></label>
                    <input asp-for="PasswortWiederholung" class="form-control" maxlength="128" autocomplete="new-password" />
                    <span asp-validation-for="PasswortWiederholung" class="text-danger"></span>
                </div>
                <div class="col-12 form-text">@PasswordPolicy.Hint</div>
            </div>
            <button type="submit" class="btn btn-primary mt-4">Administrator anlegen</button>
        </form>
    </div>
</div>
