@model DbSetupViewModel
@{
    ViewData["Title"] = "Datenbank einrichten";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-9 col-lg-6">
        <h1 class="h3 mb-3">Datenbankverbindung einrichten</h1>
        <p class="text-muted">Für den ersten Start werden die Verbindungsdaten zum MySQL-Server benötigt. Sie werden erst nach erfolgreichem Verbindungstest gespeichert; das Passwort wird verschlüsselt abgelegt.</p>

        @if (!string.IsNullOrEmpty(Model.ResultMessage))
        {
            <div class="alert @(Model.ResultSuccess ? "alert-success" : "alert-danger")" role="alert">@Model.ResultMessage</div>
        }

        <form asp-action="Save" method="post" autocomplete="off">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="row g-3">
                <div class="col-12 col-sm-8">
                    <label asp-for="Host" class="form-label"></label>
                    <input asp-for="Host" class="form-control" maxlength="255" autofocus />
                    <span asp-validation-for="Host" class="text-danger"></span>
                </div>
                <div class="col-12 col-sm-4">
                    <label asp-for="Port" class="form-label"></label>
                    <input asp-for="Port" class="form-control" type="number" min="1" max="65535" />
                    <span asp-validation-for="Port" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Database" class="form-label"></label>
                    <input asp-for="Database" class="form-control" maxlength="64" />
                    <span asp-validation-for="Database" class="text-danger"></span>
                </div>
                <div class="col-12 col-sm-6">
                    <label asp-for="UserName" class="form-label"></label>
                    <input asp-for="UserName" class="form-control" maxlength="80" autocomplete="off" />
                    <span asp-validation-for="UserName" class="text-danger"></span>
                </div>
                <div class="col-12 col-sm-6">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" class="form-control" maxlength="256" autocomplete="new-password" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="SslMode" class="form-label"></label>
                    <select asp-for="SslMode" class="form-select">
                        <option value="None">Aus</option>
                        <option value="Preferred">Bevorzugt</option>
                        <option value="Required">Erforderlich</option>
                    </select>
                    <span asp-validation-for="SslMode" class="text-danger"></span>
                </div>
            </div>
            <div class="d-flex flex-wrap gap-2 mt-4">
                <button type="submit" asp-action="Test" class="btn btn-outline-primary">Verbindung testen</button>
                <button type="submit" class="btn btn-primary">Testen und speichern</button>
            </div>
        </form>
    </div>
</div>
