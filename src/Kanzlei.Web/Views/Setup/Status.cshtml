@model Kanzlei.Web.Services.DatabaseStatus
@{
    ViewData["Title"] = "Datenbank nicht verfügbar";
}

<h1 class="h3 text-danger">Datenbank nicht verfügbar</h1>
@if (Model == Kanzlei.Web.Services.DatabaseStatus.ConfigUnreadable)
{
    <p>Die gespeicherte Datenbankkonfiguration kann nicht gelesen oder entschlüsselt werden (z. B. fehlender Schlüsselbund, beschädigte Datei). Die Anmeldung ist deshalb gesperrt.</p>
    <p>Bitte stellen Sie den Schlüsselbund aus der Datensicherung wieder her oder löschen Sie die Konfigurationsdatei auf dem Server (siehe README, Abschnitt „Wiederherstellung“), um die Einrichtung neu zu starten. Details stehen ohne Zugangsdaten im Server-Log.</p>
}
else
{
    <p>Der Datenbankserver ist derzeit nicht erreichbar. Die gespeicherte Konfiguration bleibt unverändert. Bitte versuchen Sie es in einigen Sekunden erneut.</p>
}
<a class="btn btn-primary" href="/Setup/Status">Erneut versuchen</a>
