@model MailSetupViewModel
@{
    ViewData["Title"] = "Mailserver einrichten";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-9 col-lg-6">
        <h1 class="h3 mb-3">Mailserver einrichten</h1>
        <p class="text-muted">Für das spätere Zurücksetzen von Passwörtern wird ein SMTP-Mailserver benötigt. Die Einstellungen werden erst nach erfolgreichem Verbindungstest gespeichert; das Passwort wird verschlüsselt abgelegt. Es wird keine E-Mail versendet.</p>

        @if (!string.IsNullOrEmpty(Model.ResultMessage))
        {
            <div class="alert @(Model.ResultSuccess ? "alert-success" : "alert-danger")" role="alert">@Model.ResultMessage</div>
        }

        <form asp-action="Mail" method="post" autocomplete="off">
            <partial name="_MailFields" model="Model" />
            <div class="d-flex flex-wrap gap-2 mt-4">
                <button type="submit" asp-action="MailTest" class="btn btn-outline-primary">Verbindung testen</button>
                <button type="submit" class="btn btn-primary">Testen und speichern</button>
            </div>
        </form>
    </div>
</div>
